<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="100dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/faint_sky_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">


                <TextView
                    android:id="@+id/tvItemQuizResultQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textStyle="bold"
                    android:layout_marginLeft="15dp"
                    android:textColor="@color/black"
                    android:background="@drawable/edit"
                    android:backgroundTint="@color/gray2"
                    android:textSize="18sp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- Options -->
            <TextView
                android:id="@+id/tvItemQuizResultOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/black"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvItemQuizResultOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/black"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvItemQuizResultOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/black"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvItemQuizResultOption4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/black"
                android:padding="4dp" />

            <!-- Your Answer -->
            <TextView
                android:id="@+id/tvItemQuizResultYourAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text=""
                android:textColor="@color/black"
                android:background="@color/faintyellow"
                android:textStyle="italic" />

            <!-- Correct Answer -->
            <TextView
                android:id="@+id/tvItemQuizResultCorrectAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="6dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text=""
                android:textColor="@color/black"
                android:background="@color/faintgreen"
                android:textStyle="italic" />

            <!-- Marks -->
            <TextView
                android:id="@+id/tvItemQuizResultMarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
                android:text=""
                android:textColor="#000000"
                android:textStyle="bold"
                android:background="@color/lightgray2"
                android:textAlignment="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

