<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attemptQuizLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f2f2f2">

    <!-- Quiz Timer -->
    <TextView
        android:id="@+id/timerTextViewAttemptQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Left: 10:00"
        android:textSize="18sp"
        android:textColor="#FF0000"
        android:layout_gravity="end"
        android:paddingBottom="10dp"/>

    <!-- Question Text -->
    <TextView
        android:id="@+id/tvAttemptQuizQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question appears here"
        android:textSize="20sp"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <!-- Options Group -->
    <RadioGroup
        android:id="@+id/optionsRadioGroupAttemptQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option A" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option B" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option C" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option D" />
    </RadioGroup>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnAttemptQuizPrevious"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previous"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btnAttemptQuizNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"/>
    </LinearLayout>

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnAttemptQuizSubmitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Quiz"
        android:layout_marginTop="24dp"
        android:visibility="gone"/>

</LinearLayout>
