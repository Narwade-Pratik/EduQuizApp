<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attemptQuizLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8FC"
    android:padding="16dp">

    <!-- FIXED TIMER -->
    <TextView
        android:id="@+id/timerTextViewAttemptQuiz"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:gravity="right"
        android:text="00:00:00"
        android:textColor="#FF0000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />


    <!-- SCROLLABLE QUIZ CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question -->
            <TextView
                android:id="@+id/tvAttemptQuizQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text=""
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:textColor="#000000"
                android:background="@drawable/question_back"
                android:layout_marginBottom="20dp" />


            <!-- Options -->
            <RadioGroup
                android:id="@+id/optionsRadioGroupAttemptQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioButtonAttemptQuizOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#333333"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/radioButtonAttemptQuizOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#333333"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/radioButtonAttemptQuizOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#333333"
                    android:layout_marginBottom="10dp" />

                <RadioButton
                    android:id="@+id/radioButtonAttemptQuizOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#333333"
                    android:layout_marginBottom="10dp" />

            </RadioGroup>


            <!-- Navigation Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="25dp"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAttemptQuizPrevious"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/edit2"
                    android:text="Previous"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAttemptQuizNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/edit2"
                    android:text="Next"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

            </LinearLayout>


            <!-- Submit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAttemptQuizSubmitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/edit2"
                android:text="Submit Quiz" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>