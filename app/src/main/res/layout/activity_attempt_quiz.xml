<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attemptQuizLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f2f2f2">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:weightSum="10.5"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAttemptQuizQuestion"
            android:layout_width="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="8"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:paddingLeft="5.0dp"
            android:paddingRight="5.0dp"
            android:textColor="#000000"
            android:background="@drawable/question_back"
            android:layout_marginBottom="16dp"/>

        <!-- Quiz Timer -->
        <TextView
            android:id="@+id/timerTextViewAttemptQuiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="00:00:00"
            android:layout_marginLeft="10dp"
            android:textSize="18sp"
            android:textColor="#FF0000"
            android:paddingTop="10dp"/>

    </LinearLayout>

    <!-- Question Text -->


    <!-- Options Group -->
    <RadioGroup
        android:id="@+id/optionsRadioGroupAttemptQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

        <RadioButton
            android:id="@+id/radioButtonAttemptQuizOptionD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
    </RadioGroup>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="250dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAttemptQuizPrevious"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textStyle="bold"
            android:background="@color/green"
            android:text="Previous" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAttemptQuizNext"
            android:layout_width="120dp"
            android:background="@color/green"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:layout_marginLeft="120dp"
            android:text="Next"/>


    </LinearLayout>

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAttemptQuizSubmitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:layout_marginTop="25dp"
        android:background="@color/sky_blue"
        android:text="Submit Quiz"/>
    <!--android:visibility="gone"-->

</LinearLayout>
