<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/quizlogo"
        android:layout_marginBottom="20dp" />
    
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="355dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="16dp"
        android:elevation="100dp"
        android:backgroundTint="@color/gray2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registration"
            android:textSize="30dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/caveat_brush"
            android:layout_marginLeft="120dp"
            android:layout_marginTop="7dp"/>

            <EditText
                android:id="@+id/etregname"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/man_24"
                android:fontFamily="@font/alice"
                android:hint="Enter your Name"
                android:padding="4dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textStyle="normal"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etregusername"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/usernamelogo"
                android:fontFamily="@font/alice"
                android:hint="Create Your Username"
                android:padding="4dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textStyle="normal"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etregemailid"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/edit"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:hint="Enter your Email Id"
                android:textColorHint="@color/black"
                android:fontFamily="@font/alice"
                android:drawableStart="@drawable/email"
                android:padding="4dp"
                android:textColor="@color/black"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etregphno"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/edit"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:hint="Enter your Phone No"
                android:textColorHint="@color/black"
                android:fontFamily="@font/alice"
                android:drawableStart="@drawable/phone_logo"
                android:padding="4dp"
                android:drawablePadding="10dp"
                android:textColor="@color/black"
                android:inputType="number"/>

            <EditText
                android:id="@+id/etregpwd"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/edit"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:hint="Enter your Password"
                android:textColorHint="@color/black"
                android:fontFamily="@font/alice"
                android:drawableStart="@drawable/passwordlogo"
                android:padding="4dp"
                android:textColor="@color/black"
                android:inputType="numberPassword"
                android:drawablePadding="10dp"/>

            <EditText
                android:id="@+id/etregconfirmpwd"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/edit"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:hint="Confirm your Password"
                android:textColorHint="@color/black"
                android:fontFamily="@font/alice"
                android:drawableStart="@drawable/confirmpwd"
                android:padding="4dp"
                android:inputType="numberPassword"
                android:textColor="@color/black"
                android:drawablePadding="10dp"/>


            <Button
                android:id="@+id/btregregister"
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/green"
                android:text="Register"
                android:textSize="15dp"
                android:textColor="@color/black"
                android:layout_marginLeft="130dp"/>

            <TextView
                android:id="@+id/tvregalreadyacc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account"
                android:textColor="@color/black"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="15dp"
                android:textSize="15dp"
                />






        </LinearLayout>

    </androidx.cardview.widget.CardView>
    
    
        
</LinearLayout>