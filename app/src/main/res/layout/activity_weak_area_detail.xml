<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvWeakAreaDetailStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="16dp"
        android:text="Student"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.vinodnarwade.eduquiz.teacheractivities.PieChartView
        android:id="@+id/pieChartWeakAreaDetail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="#85E48A" />

        <TextView
            android:id="@+id/tvLegendCorrect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:text="Correct"
            android:textColor="#212121"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#E67373" />

        <TextView
            android:id="@+id/tvLegendIncorrect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:text="Incorrect"
            android:textColor="#212121"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#99E0EA" />

        <TextView
            android:id="@+id/tvLegendUnattempted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Unattempted"
            android:textColor="#212121"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvWeakAreaDetailEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="No performance data available for this student yet."
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewWeakAreaDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="16dp" />

</LinearLayout>