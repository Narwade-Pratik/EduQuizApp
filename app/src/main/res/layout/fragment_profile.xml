<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.ProfileFragment"
    android:orientation="vertical"
    android:gravity="center">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civ_profile_fragment_image"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/profile_image"
        app:civ_border_color="@color/black"
        app:civ_border_width="2dp" >
    </de.hdodenhof.circleimageview.CircleImageView>

    <LinearLayout
        android:id="@+id/layout1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_below="@id/civ_profile_fragment_image"
        android:layout_marginTop="20dp"
        android:padding="3dp"
        android:layout_marginLeft="15dp"
        android:weightSum="50">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="12"
            android:layout_height="50dp"
            android:text="Name :"
            android:textSize="20dp"
            android:paddingTop="9dp"
            android:paddingLeft="8dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_profile_fragment_name"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="33"
            android:hint="Your name...."
            android:padding="15dp"
            android:background="@drawable/edit2"
            android:layout_marginTop="2dp"
            android:inputType="text"
            android:layout_marginBottom="2dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_below="@id/layout1"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="15dp"
        android:padding="3dp"
        android:weightSum="50">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="12"
            android:layout_height="50dp"
            android:text="ID :"
            android:textSize="20dp"
            android:paddingTop="9dp"
            android:paddingLeft="20dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_profile_fragment_id"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="33"
            android:hint="Your ID......"
            android:padding="15dp"
            android:background="@drawable/edit2"
            android:layout_marginTop="2dp" android:focusable="false"
            android:cursorVisible="false"
            android:clickable="false"
            android:longClickable="false"
            android:inputType="none"
            android:layout_marginBottom="2dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout3"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_below="@id/layout2"
        android:layout_marginTop="5dp"
        android:padding="3dp"
        android:layout_marginLeft="15dp"
        android:weightSum="50">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="12"
            android:layout_height="50dp"
            android:text="Pass :"
            android:textSize="20dp"
            android:paddingTop="9dp"
            android:paddingLeft="8dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_profile_fragment_password"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="33"
            android:hint="Your password....."
            android:padding="15dp"
            android:background="@drawable/edit2"
            android:layout_marginTop="2dp"
            android:inputType="number"
            android:layout_marginBottom="2dp"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout4"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_below="@id/layout3"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="130dp"
        android:padding="3dp"
        android:weightSum="50"
        android:layout_marginLeft="15dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="12"
            android:layout_height="50dp"
            android:text="Role :"
            android:textSize="20dp"
            android:paddingTop="9dp"
            android:paddingLeft="8dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_profile_fragment_role"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="33"
            android:hint="Your role ....."
            android:padding="15dp"
            android:background="@drawable/edit2"
            android:layout_marginTop="2dp"
            android:inputType="text"
            android:layout_marginBottom="2dp"/>

    </LinearLayout>

</LinearLayout>