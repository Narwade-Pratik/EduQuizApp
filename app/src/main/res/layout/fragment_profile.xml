<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true"
    tools:context=".fragments.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Profile Image -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civ_profile_fragment_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/profile_image"
            android:contentDescription="Profile Image"
            app:civ_border_color="@color/black"
            app:civ_border_width="2dp" />


        <!-- Profile Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="My Profile"
            android:textColor="#1F2937"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />


        <!-- Name -->
        <LinearLayout
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="50">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="12"
                android:text="Name :"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_profile_fragment_name"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="33"
                android:hint="Your name"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/edit2"
                android:inputType="text"
                android:singleLine="true" />

        </LinearLayout>


        <!-- ID -->
        <LinearLayout
            android:id="@+id/layout2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="50">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="12"
                android:text="ID :"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_profile_fragment_id"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="33"
                android:hint="Your ID"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/edit2"
                android:focusable="false"
                android:cursorVisible="false"
                android:clickable="false"
                android:longClickable="false"
                android:inputType="none"
                android:singleLine="true" />

        </LinearLayout>


        <!-- Password -->
        <LinearLayout
            android:id="@+id/layout3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="50">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="12"
                android:text="Pass :"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_profile_fragment_password"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="33"
                android:hint="Your password"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/edit2"
                android:inputType="number"
                android:singleLine="true" />

        </LinearLayout>


        <!-- Role -->
        <LinearLayout
            android:id="@+id/layout4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="50">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="12"
                android:text="Role :"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_profile_fragment_role"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="33"
                android:hint="Your role"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/edit2"
                android:inputType="text"
                android:singleLine="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>