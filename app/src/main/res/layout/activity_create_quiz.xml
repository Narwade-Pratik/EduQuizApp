<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".teacheractivities.CreateQuizActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/adamina"
        android:text="Enter Quiz Details"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:backgroundTint="@color/gray2"
        app:cardCornerRadius="10dp"
        android:elevation="100dp"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/new_card_background"
            android:orientation="vertical">
            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequizquiztitile"
                android:hint="Enter Quiz Title"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp" />

            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequiznoofquestions"
                android:hint="Enter Number Of Questions"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp"/>

            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequizsubjectname"
                android:hint="Enter subject name"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp"/>

            <!-- Schedule Date & Time Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btncreatequizschedulefirsttimeanddate"
                android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:text="Set First Date and Time"
                android:textSize="20dp"
                android:backgroundTint="@color/SkyBlue"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <!-- Show Selected Schedule Date -->
            <TextView
                android:id="@+id/tvcreatequizdiplayscheduledfirsttimeanddate"
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:text="No Date Selected"
                android:textSize="20dp"
                android:textAlignment="center"
                android:textStyle="italic"
                android:textColor="@color/black"
                android:background="@drawable/edit2"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btncreatequizschedulesecondtimeanddate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Second Date and Time"
                android:textSize="20dp"
                android:backgroundTint="@color/SkyBlue"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <!-- Show Selected Schedule Date -->
            <TextView
                android:id="@+id/tvcreatequizdiplayscheduledsecondtimeanddate"
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:text="No Date Selected"
                android:textSize="20dp"
                android:textAlignment="center"
                android:textStyle="italic"
                android:textColor="@color/black"
                android:background="@drawable/edit2"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btncreatequizcreatequiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20dp"
                android:backgroundTint="@color/blue2"
                android:text="Create"
                android:textColor="@color/white"/>


        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

