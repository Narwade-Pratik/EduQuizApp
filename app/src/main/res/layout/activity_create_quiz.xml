<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    tools:context=".teacheractivities.CreateQuizActivity">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="30dp"
        android:text="Enter Quiz Details"
        android:textStyle="bold"
        android:fontFamily="@font/caveat_brush"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:backgroundTint="@color/gray2"
        app:cardCornerRadius="10dp"
        android:elevation="100dp"
        android:layout_margin="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequizquiztitile"
                android:hint="Enter Quiz Title"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp" />

            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequiznoofquestions"
                android:hint="Enter Number Of Questions"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp"/>

            <EditText
                android:layout_width="300dp"
                android:layout_height="30dp"
                android:id="@+id/etcreatequizsubjectname"
                android:hint="Enter subject name"
                android:paddingLeft="10dp"
                android:textSize="20dp"
                android:fontFamily="@font/alice"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="text"
                android:background="@drawable/edit2"
                android:layout_margin="10dp"/>


            <Button
                android:id="@+id/btncreatequizcreatequiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20dp"
                android:backgroundTint="@color/black"
                android:text="Create"
                android:textColor="@color/white"/>


        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

