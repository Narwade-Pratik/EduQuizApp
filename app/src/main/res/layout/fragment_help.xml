<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvHelpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help &amp; Support"
            android:textColor="#1F2937"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvHelpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="24dp"/>


        <!-- Search -->
        <EditText
            android:id="@+id/etHelpSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Search help"
            android:textSize="15sp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="28dp"/>


        <!-- Quiz Generation -->
        <TextView
            android:id="@+id/tvHelpQuizGenerationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Generation"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpQuizGeneration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="22dp"/>


        <!-- Customized Quiz -->
        <TextView
            android:id="@+id/tvHelpCustomizedQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customized Quiz"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpCustomizedQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="22dp"/>


        <!-- Attempt Quiz -->
        <TextView
            android:id="@+id/tvHelpAttemptQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attempting a Quiz"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpAttemptQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="22dp"/>


        <!-- Quiz Results -->
        <TextView
            android:id="@+id/tvHelpQuizResultsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Results"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpQuizResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="22dp"/>


        <!-- Profile -->
        <TextView
            android:id="@+id/tvHelpProfileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="22dp"/>


        <!-- Support -->
        <TextView
            android:id="@+id/tvHelpSupportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Support"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvHelpSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#374151"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>