<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Question"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvQuestionBankInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class > Subject > Chapter > Topic"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Difficulty: Easy"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etQBQuestionTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Question Topic"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQBQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Question"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQBOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option A"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option B"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option C"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option D"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQBCorrectOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correct Option (A/B/C/D)"
            android:inputType="textCapCharacters"
            android:maxLength="1"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQBMarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marks"
            android:inputType="number"
            android:layout_marginBottom="24dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddQBQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Question"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>