<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray2"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Add Question"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>


        <!-- Question Bank Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">



            <TextView
                android:id="@+id/tvQuestionBankInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Class > Subject > Chapter > Topic"
                android:textColor="#202A3A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="4dp"/>

        </LinearLayout>


        <!-- Difficulty -->
        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Difficulty: Easy"
            android:textColor="#247A45"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/edittext_border"
            android:padding="13dp"
            android:layout_marginBottom="20dp"/>


        <!-- Question Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question Details"
            android:textColor="#202A3A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>


        <!-- Topic -->
        <EditText
            android:id="@+id/etQBQuestionTopic"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Question Topic"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="12dp"/>


        <!-- Question -->
        <EditText
            android:id="@+id/etQBQuestion"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Enter Question"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:padding="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="18dp"/>


        <!-- Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Answer Options"
            android:textColor="#202A3A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>


        <EditText
            android:id="@+id/etQBOptionA"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Option A"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionB"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Option B"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionC"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Option C"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBOptionD"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Option D"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="18dp"/>


        <!-- Answer & Marks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Answer and Marks"
            android:textColor="#202A3A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQBCorrectOption"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Correct Option (A/B/C/D)"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:inputType="textCapCharacters"
            android:maxLength="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etQBMarks"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Marks"
            android:textSize="15sp"
            android:textColor="#202A3A"
            android:textColorHint="#98A2B3"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/edittext_border"
            android:layout_marginBottom="24dp"/>


        <!-- Add Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddQBQuestion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Add Question"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#62EB4A"
            android:elevation="3dp"/>

    </LinearLayout>

</ScrollView>