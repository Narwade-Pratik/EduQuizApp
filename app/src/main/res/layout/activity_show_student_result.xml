<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/resultLayoutShowStudentResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Quiz Details -->
        <TextView
            android:id="@+id/tvShowStudentResultQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Title"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShowStudentResultSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShowStudentResultScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: 0/0"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShowStudentResultRank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rank: N/A"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvShowStudentResultTimeTaken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time taken in Minutes"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShowStudentResultTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teacher Name"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShowStudentResultDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date and Time"
            android:textSize="16sp"
            android:paddingBottom="4dp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <!-- All Attempted Questions Will Be Added Here Dynamically -->
        <LinearLayout
            android:id="@+id/questionsContainerShowStudentResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
