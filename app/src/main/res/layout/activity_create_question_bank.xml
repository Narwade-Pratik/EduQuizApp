<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Question Bank"
            android:textColor="#1F2937"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-----------------------------------------------------------------------------------------------"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="28dp"/>


        <!-- Class -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp"/>

        <EditText
            android:id="@+id/etCreateQBClass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter class"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="20dp"/>


        <!-- Subject -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp"/>

        <EditText
            android:id="@+id/etCreateQBSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter subject"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="20dp"/>


        <!-- Chapter -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chapter"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp"/>

        <EditText
            android:id="@+id/etCreateQBChapter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter chapter"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="20dp"/>


        <!-- Topic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Topic"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp"/>

        <EditText
            android:id="@+id/etCreateQBTopic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter topic"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/edit2"
            android:layout_marginBottom="32dp"/>


        <!-- Create Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateQuestionBank"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Question Bank"
            android:textColor="#0A0B0A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:background="@drawable/button_bg"
            android:backgroundTint="@color/gray2"
            android:elevation="3dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>