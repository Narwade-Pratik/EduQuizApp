<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01"
            android:text="Create Customized Quiz"
            android:textColor="#1F2937"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- Subject -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="Subject"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerCustomSubject"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit2"
                android:paddingStart="14dp"
                android:paddingEnd="45dp"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="Dropdown"
                android:src="@drawable/ic_dropdown_arrow" />
        </FrameLayout>

        <!-- Chapter -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="Chapter"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerCustomChapter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit2"
                android:paddingStart="14dp"
                android:paddingEnd="45dp"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="Dropdown"
                android:src="@drawable/ic_dropdown_arrow" />
        </FrameLayout>

        <!-- Topic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="Topic"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp">

            <Spinner
                android:id="@+id/spinnerCustomTopic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit2"
                android:paddingStart="14dp"
                android:paddingEnd="45dp"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="Dropdown"
                android:src="@drawable/ic_dropdown_arrow" />
        </FrameLayout>

        <!-- Number of Questions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="Number of Questions"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNumberOfQuestions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edit2"
            android:fontFamily="sans-serif"
            android:hint="Enter number of questions"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp" />

        <!-- Difficulty -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:fontFamily="sans-serif-medium"
            android:text="Difficulty"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="32dp">

            <Spinner
                android:id="@+id/spinnerCustomDifficulty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edit2"
                android:paddingStart="14dp"
                android:paddingEnd="45dp"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:contentDescription="Dropdown"
                android:src="@drawable/ic_dropdown_arrow" />
        </FrameLayout>

        <!-- Generate Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGenerateCustomQuiz"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_bg"
            android:backgroundTint="@color/blue"
            android:elevation="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Generate Quiz"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>