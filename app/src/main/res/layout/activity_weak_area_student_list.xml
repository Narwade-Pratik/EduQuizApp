<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvWeakAreaStudentListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="16dp"
        android:text="Weak Area Report"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSendReportToParents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/darkgreen"
        android:text="Send Report to Parents"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWeakAreaStudentsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWeakAreaStudentListTitle"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="No students have attempted your quizzes yet."
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewWeakAreaStudents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvWeakAreaStudentListTitle"
        android:layout_above="@id/btnSendReportToParents"
        android:paddingBottom="8dp" />

</RelativeLayout>