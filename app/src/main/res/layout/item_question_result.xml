<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"

    app:cardBackgroundColor="#D6F5F0"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvItemResultQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gray"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Q1. Question text"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemResultOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A. Option"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItemResultOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="B. Option"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItemResultOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="C. Option"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItemResultOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="D. Option"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItemResultYourAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_yellow"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Your Answer: B"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvItemResultCorrectAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Correct Answer: A"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvItemResultMarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_gray"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Marks Awarded: 1/1"
            android:textColor="#212121"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>