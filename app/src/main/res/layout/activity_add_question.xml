<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray2"
    tools:context=".teacheractivities.AddQuestionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Question"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:fontFamily="@font/alice"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="40dp"/>

        <!-- Question Field -->
        <EditText
            android:id="@+id/etaddquestionquestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Question"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Option A to D -->
        <EditText
            android:id="@+id/etaddquestionoptiona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Option A"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etaddquestionoptionb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Option B"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etaddquestionoptionc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Option C"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etaddquestionoptiond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Option D"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etaddquestioncorrectoption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter correct option like A or B or C or D"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etaddquestionmarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter marks for this question"
            android:textSize="18sp"
            android:fontFamily="@font/alice"
            android:textColorHint="@color/black"
            android:textColor="@color/black"
            android:inputType="text"
            android:background="@drawable/edit2"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Submit Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnaddquestionprevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Previous Question"
                android:textColor="@color/white"
                android:fontFamily="@font/alice"
                android:backgroundTint="@color/black"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:layout_marginRight="10dp"/>

            <Button
                android:id="@+id/btnlogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Add Question"
                android:textColor="@color/white"
                android:fontFamily="@font/alice"
                android:backgroundTint="@color/black"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnaddquestionadd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="Add Question"
            android:textColor="@color/white"
            android:fontFamily="@font/alice"
            android:backgroundTint="@color/black"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"/>
    </LinearLayout>
</ScrollView>
