<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray2"
    tools:context=".teacheractivities.ViewQuizActivity">

   <androidx.cardview.widget.CardView
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:layout_marginLeft="15dp"
       android:layout_marginTop="30dp"
       android:layout_marginRight="15dp"
       app:cardCornerRadius="15dp"

       >
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           android:padding="24dp"
            android:background="@drawable/new_card_background"
           android:gravity="center_horizontal">

           <TextView
               android:id="@+id/tvreviewcurrentquestion"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Viewing Question"
               android:textSize="24sp"
               android:textColor="@color/black"
               android:fontFamily="@font/alice"
               android:textStyle="bold"
               android:layout_marginBottom="24dp"
               android:layout_marginTop="40dp" />

           <EditText
               android:id="@+id/etreviewquestionquestion"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Question"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="16dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestionoptiona"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Option A"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="12dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestionoptionb"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Option B"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="12dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestionoptionc"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Option C"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="12dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestionoptiond"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Option D"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="16dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestioncorrectoption"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Correct Option"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="16dp"
               android:enabled="false" />

           <EditText
               android:id="@+id/etreviewquestionmarks"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:hint="Marks"
               android:textSize="18sp"
               android:fontFamily="@font/alice"
               android:inputType="text"
               android:background="@drawable/edit2"
               android:padding="12dp"
               android:layout_marginBottom="16dp"
               android:enabled="false" />

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:gravity="center_horizontal">

               <androidx.appcompat.widget.AppCompatButton
                   android:id="@+id/btnreviewquestionprevious"
                   android:layout_width="130dp"
                   android:layout_height="wrap_content"
                   android:textSize="18sp"
                   android:textStyle="bold"
                   android:text="Previous"
                   android:fontFamily="@font/alice"
                   android:textColor="@color/black"
                   android:backgroundTint="@color/blue"
                   android:layout_marginEnd="8dp" />

               <androidx.appcompat.widget.AppCompatButton
                   android:id="@+id/btnreviewquestionnext"
                   android:layout_width="130dp"
                   android:layout_height="wrap_content"
                   android:textSize="18sp"
                   android:text="Next"
                   android:textStyle="bold"
                   android:fontFamily="@font/alice"
                   android:textColor="@color/black"
                   android:backgroundTint="@color/blue" />
           </LinearLayout>

           <View
               android:id="@+id/btnreviewsubmitquiz"
               android:layout_width="0dp"
               android:layout_height="0dp"
               android:visibility="gone" />
       </LinearLayout>

   </androidx.cardview.widget.CardView>

</ScrollView>
