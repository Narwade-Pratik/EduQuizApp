<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPreviousQuizzes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:layout_gravity="center"
    tools:context=".teacheractivities.PreviousQuizesActivity">

    <TextView
        android:id="@+id/tvPreviousQuizzesHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Previous Quizzes"
        android:background="@drawable/edit2"
        android:padding="10dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:paddingBottom="16dp" />

    <!-- ProgressBar while loading -->
    <ProgressBar
        android:id="@+id/progressBarPreviousQuizesActivity"
        android:layout_marginTop="350dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- No Quiz Text -->
    <TextView
        android:id="@+id/noQuizPreviousQuizesActivityQuizText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No quizzes found"
        android:textSize="16sp"
        android:textColor="#888888"
        android:layout_centerInParent="true"
        android:visibility="gone" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPreviousQuizzes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBarPreviousQuizesActivity"
        android:scrollbars="vertical" />
</LinearLayout>